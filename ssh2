#!/bin/bash

set -euo pipefail

SCRIPT_PATH=${BASH_SOURCE[0]}
while [[ -L $SCRIPT_PATH ]]; do
  SCRIPT_DIR=$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)
  SCRIPT_PATH=$(readlink -- "$SCRIPT_PATH")
  [[ $SCRIPT_PATH == /* ]] || SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done
SCRIPT_DIR=$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)
CONFIG_FILE="$SCRIPT_DIR/ssh2.config"

usage() {
  printf 'Usage: ssh2 [--no-mdns | --scan [IPv4-subnet/CIDR]]\n\n'
  printf 'Without arguments, merge ssh2.config with mDNS SSH discoveries (5-second wait budget, capped results).\n'
  printf 'With --no-mdns, use only ssh2.config. Discoveries are never saved.\n'
  printf 'With --scan, discover open SSH ports (TCP 22); default: 192.168.7.0/24.\n'
  printf 'Scan results are temporary. Only scan networks you have permission to scan.\n'
}

scan=false
mdns=true
subnet=192.168.7.0/24
case "${1:-}" in
  --scan)
    [[ $# -le 2 ]] || { usage >&2; exit 1; }
    scan=true
    subnet=${2:-$subnet}
    ;;
  --no-mdns)
    [[ $# -eq 1 ]] || { usage >&2; exit 1; }
    mdns=false
    ;;
  -h|--help)
    usage
    exit 0
    ;;
  '') ;;
  *) usage >&2; exit 1 ;;
esac

if $scan; then
  if [[ ! $subnet =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$ ]]; then
    echo "Invalid IPv4 subnet: $subnet (expected e.g. 192.168.7.0/24)" >&2
    exit 1
  fi
  IFS='./' read -r a b c d prefix <<< "$subnet"
  for octet in "$a" "$b" "$c" "$d"; do
    if (( 10#$octet > 255 )); then
      echo "Invalid IPv4 subnet: $subnet" >&2
      exit 1
    fi
  done
  if ! command -v nmap >/dev/null 2>&1; then
    echo 'Scanning requires nmap. Install with: sudo pacman -S nmap (Arch) or brew install nmap (macOS).' >&2
    exit 1
  fi
elif ! $mdns && [[ ! -f "$CONFIG_FILE" ]]; then
  echo "Missing config file: $CONFIG_FILE" >&2
  exit 1
fi

labels=()
ips=()
ports=()
prompt_user=()
mdns_hosts=()

if [[ -f "$CONFIG_FILE" ]]; then
  while IFS= read -r raw_line || [[ -n "$raw_line" ]]; do
    line=${raw_line#"${raw_line%%[![:space:]]*}"}
    line=${line%"${line##*[![:space:]]}"}

    [[ -z "$line" ]] && continue
    [[ ${line:0:1} == "#" ]] && continue

    read -r label ip extra <<< "$line"

    if [[ -z "${label:-}" || -z "${ip:-}" || -n "${extra:-}" ]]; then
      echo "Invalid config line: $raw_line" >&2
      exit 1
    fi

    labels+=("$label")
    ips+=("$ip")
    ports+=(22)
    prompt_user+=(false)
    mdns_hosts+=("")
  done < "$CONFIG_FILE"
fi

if $scan; then
  printf 'Scanning %s for TCP port 22 (this may take a while)...\n' "$subnet"
  # Capture the exit status before parsing so scan failures cannot look like
  # successful scans with no results. -Pn also checks hosts that ignore ping.
  if ! scan_output=$(nmap -sT -Pn -p 22 --open -oG - "$subnet"); then
    echo 'Network scan failed.' >&2
    exit 1
  fi

  discovered_labels=()
  discovered_ips=()
  while IFS=$'\t' read -r ip hostname; do
    [[ -n "$ip" ]] || continue
    label=${hostname:-$ip}
    for (( i=0; i<${#ips[@]}; i++ )); do
      if [[ ${ips[$i]} == "$ip" ]]; then
        label=${labels[$i]}
        break
      fi
    done
    discovered_labels+=("$label")
    discovered_ips+=("$ip")
  done < <(printf '%s\n' "$scan_output" | awk '
    /^Host: / && /Ports: 22\/open\/tcp\// {
      hostname = $3
      gsub(/^\(|\)$/, "", hostname)
      if (!seen[$2]++) printf "%s\t%s\n", $2, hostname
    }
  ')

  if [[ ${#discovered_ips[@]} -eq 0 ]]; then
    printf 'No hosts with TCP port 22 open found on %s.\n' "$subnet" >&2
    exit 1
  fi
  labels=("${discovered_labels[@]}")
  ips=("${discovered_ips[@]}")
  for (( i=0; i<${#ips[@]}; i++ )); do
    ports[$i]=22
    prompt_user[$i]=true
  done
elif $mdns; then
  if [[ -r $SCRIPT_DIR/lib/ssh2-mdns.sh ]]; then
    source "$SCRIPT_DIR/lib/ssh2-mdns.sh"
    # Normalize each manual target once, not in the discovery comparison loop.
    for (( i=0; i<${#ips[@]}; i++ )); do
      mdns_hosts[$i]=$(printf '%s' "${ips[$i]%.}" | LC_ALL=C tr '[:upper:]' '[:lower:]')
    done
    while IFS=$'\t' read -r host address port; do
      [[ -n $host ]] || continue
      duplicate=false
      for (( i=0; i<${#ips[@]}; i++ )); do
        if [[ ${ports[$i]} == "$port" ]] &&
           [[ ${ips[$i]} == "$address" || ${mdns_hosts[$i]} == "$host" ]]; then
          duplicate=true
          break
        fi
      done
      $duplicate && continue
      labels+=("${host%.local}")
      ips+=("$address")
      ports+=("$port")
      prompt_user+=(true)
      mdns_hosts+=("$host")
    done < <(ssh2_mdns)
  else
    echo 'mDNS helper missing; using configured targets. Keep ssh2 with its lib directory.' >&2
  fi
fi

if [[ ${#ips[@]} -eq 0 ]]; then
  echo "No SSH targets found in $CONFIG_FILE" >&2
  exit 1
fi

if [[ ! -t 0 || ! -t 1 ]]; then
  echo 'The SSH target menu requires an interactive terminal.' >&2
  exit 1
fi

cleanup() {
  stty "$original_stty" || true
  tput cnorm || true
}

draw_menu() {
  local selected_index=$1

  tput clear
  printf 'Select an SSH target and press Enter (q to cancel):\n\n'

  for i in "${!ips[@]}"; do
    endpoint=${ips[$i]}
    [[ ${ports[$i]} == 22 ]] || endpoint="$endpoint:${ports[$i]}"
    if [[ $i -eq $selected_index ]]; then
      printf '> %s (%s)\n' "${labels[$i]}" "$endpoint"
    else
      printf '  %s (%s)\n' "${labels[$i]}" "$endpoint"
    fi
  done
}

original_stty=$(stty -g)
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
stty -echo -icanon time 0 min 1
tput civis

selected=0
draw_menu "$selected"

while true; do
  IFS= read -rsn1 key

  if [[ $key == "" || $key == $'\n' || $key == $'\r' ]]; then
    break
  fi

  if [[ $key == $'\x1b' ]]; then
    IFS= read -rsn2 rest || true
    key+="$rest"
  fi

  case "$key" in
    q|Q) exit 0 ;;
    $'\x1b[A')
      if (( selected > 0 )); then
        selected=$((selected - 1))
      else
        selected=$((${#ips[@]} - 1))
      fi
      draw_menu "$selected"
      ;;
    $'\x1b[B')
      if (( selected < ${#ips[@]} - 1 )); then
        selected=$((selected + 1))
      else
        selected=0
      fi
      draw_menu "$selected"
      ;;
  esac
done

cleanup
trap - EXIT INT TERM

ssh_options=()
if ${prompt_user[$selected]}; then
  default_user=$(id -un)
  while true; do
    read -r -p "SSH username [$default_user]: " username
    username=${username:-$default_user}
    if [[ $username != -* && $username != *[[:space:]]* ]]; then
      break
    fi
    echo 'Enter a username without whitespace or a leading dash.' >&2
  done
  ssh_options=(-l "$username")
  # Advertised endpoints must not inherit a different port from SSH config.
  $scan || ssh_options+=(-p "${ports[$selected]}")
fi

printf 'Connecting to %s (%s)\n' "${labels[$selected]}" "${ips[$selected]}"
# The conditional expansion also works with empty arrays under Bash 3 nounset.
exec ssh ${ssh_options[@]+"${ssh_options[@]}"} -- "${ips[$selected]}"
